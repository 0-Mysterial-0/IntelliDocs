# ──────────────────────────────────────────────────────────────────────────────
# KMRL IntelliDocs – Environment Variables Template
# Copy this to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="KMRL IntelliDocs"
DEBUG=true
ENVIRONMENT=development
API_VERSION=v1

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# For Docker Compose (use service name 'postgres'):
DATABASE_URL=postgresql+asyncpg://postgres:kmrl_secure_password@postgres:5432/kmrl_intellidocs
# For local development (no Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/kmrl_intellidocs

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=kmrl-intellidocs-super-secret-jwt-key-change-in-production-sih25080
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MinIO (Local S3 Object Storage) ──────────────────────────────────────────
# For Docker Compose (use service name 'minio'):
MINIO_ENDPOINT=minio:9000
# For local development:
# MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=kmrl-documents
MINIO_SECURE=false
MINIO_REGION=ap-south-1

# ── ChromaDB (Vector Database) ────────────────────────────────────────────────
# For Docker Compose (use service name 'chromadb', internal port 8000):
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# For local development:
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=kmrl_documents

# ── Ollama (Local LLM) ────────────────────────────────────────────────────────
# For Docker Compose (use service name 'ollama'):
OLLAMA_HOST=http://ollama:11434
# For local development:
# OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# ── Google Gemini API (Fallback when Ollama unavailable) ─────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── AI Configuration ──────────────────────────────────────────────────────────
USE_OLLAMA=true               # Try Ollama first
USE_GEMINI_FALLBACK=true      # Fall back to Gemini if Ollama unavailable
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CONTEXT_DOCS=5

# ── Redis (Caching + Rate Limiting) ──────────────────────────────────────────
# For Docker Compose:
REDIS_URL=redis://redis:6379/0
# For local development:
# REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,image/png,image/jpeg,application/zip

# ── OCR ───────────────────────────────────────────────────────────────────────
OCR_LANGUAGES=en,ml
OCR_USE_GPU=false     # Set true if CUDA GPU available

# ── Email (for password reset - optional for demo) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@kmrl.in
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=KMRL IntelliDocs <noreply@kmrl.in>

# ── Demo / Seed ───────────────────────────────────────────────────────────────
SEED_DATABASE=true          # Auto-seed on first startup
DEMO_ADMIN_EMAIL=admin@kmrl.in
DEMO_ADMIN_PASSWORD=Admin@123456
